# Configuración del servidor
PORT=3000

# ==========================================
# SUPABASE CONFIGURATION
# Obtén estos valores en tu dashboard de Supabase (Project Settings -> API)
# ==========================================
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-o-anon-key

# ==========================================
# WHATSAPP AUTOMATION CONFIGURATION
# ==========================================
# Proveedores soportados:
# 1) "evolution" -> Evolution API (WhatsApp libre / QR)
# 2) "meta" -> Cloud API Oficial de WhatsApp (Facebook Developers)
# 3) "custom_webhook" -> Cualquier webhook o bot (ej: n8n, Make, Twilio)
WHATSAPP_PROVIDER=evolution

# Si usas Evolution API:
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_KEY=tu-api-key-de-evolution
WHATSAPP_INSTANCE=sbarber

# Si usas Meta Cloud API (Oficial):
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=

# Horas antes de la cita para mandar recordatorio automático (por defecto 2 horas antes)
WHATSAPP_REMINDER_HOURS_BEFORE=2
